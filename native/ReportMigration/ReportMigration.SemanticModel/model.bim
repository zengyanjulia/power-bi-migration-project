        "partitions": [
          {
            "name": "Items",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Source = #table(type table [#\"Epic Key\" = type text, #\"Issue Key\" = type text, #\"Parent Key\" = type text, #\"Item Type\" = type text, #\"Summary\" = type text, #\"Owner\" = type text, #\"Status\" = type text, #\"Open Risk\" = type text, #\"Open Blocker\" = type text, #\"Next Action\" = type text, #\"Action Owner\" = type text, #\"Story Points\" = Int64.Type, #\"Start Day\" = Int64.Type, #\"End Day\" = Int64.Type, #\"Blocker Age Days\" = Int64.Type, #\"Action Due Day\" = Int64.Type, #\"Target Start Date\" = type nullable datetime, #\"Target End Date\" = type nullable datetime, #\"Actual Start Date\" = type nullable datetime, #\"Actual End Date\" = type nullable datetime, #\"Potential Issue\" = type text, #\"Schedule item\" = type text], {",
                "    {\"MIG-101\", \"MIG-3212\", \"MIG-101\", \"Task\", \"Inventory legacy report logic\", \"N. Ellis\", \"Done\", null, null, null, null, 13, 9, 12, null, null, #datetime(2026,11,9,0,0,0), #datetime(2026,11,12,0,0,0), #datetime(2026,11,9,0,0,0), #datetime(2026,11,12,0,0,0), \"\", \"MIG-3212 · Inventory legacy report logic\"},",
                "    {\"MIG-101\", \"MIG-55050\", \"MIG-3212\", \"Subtask\", \"Prepare inventory legacy report logic evidence\", \"N. Ellis\", \"Done\", null, null, null, null, null, null, null, null, null, null, null, null, null, \"\", \"↳ MIG-3212 / MIG-55050 · Prepare inventory legacy report logic evidence\"},",
                "    {\"MIG-101\", \"MIG-55051\", \"MIG-3212\", \"Subtask\", \"Verify acceptance criteria\", \"N. Ellis\", \"Done\", null, null, null, null, null, null, null, null, null, null, null, null, null, \"\", \"↳ MIG-3212 / MIG-55051 · Verify acceptance criteria\"},",
                "    {\"MIG-101\", \"MIG-3213\", \"MIG-101\", \"Story\", \"Agree the valuation grain\", \"M. Park\", \"Done\", null, null, null, null, 8, 11, 14, null, null, #datetime(2026,11,11,0,0,0), #datetime(2026,11,14,0,0,0), #datetime(2026,11,11,0,0,0), #datetime(2026,11,13,0,0,0), \"\", \"MIG-3213 · Agree the valuation grain\"},",
                "    {\"MIG-101\", \"MIG-55053\", \"MIG-3213\", \"Subtask\", \"Prepare agree the valuation grain evidence\", \"M. Park\", \"Done\", null, null, null, null, null, null, null, null, null, null, null, null, null, \"\", \"↳ MIG-3213 / MIG-55053 · Prepare agree the valuation grain evidence\"},",
                "    {\"MIG-101\", \"MIG-55054\", \"MIG-3213\", \"Subtask\", \"Verify acceptance criteria\", \"M. Park\", \"Done\", null, null, null, null, null, null, null, null, null, null, null, null, null, \"\", \"↳ MIG-3213 / MIG-55054 · Verify acceptance criteria\"},",
                "    {\"MIG-101\", \"MIG-3214\", \"MIG-101\", \"Story\", \"Build the semantic model\", \"R. Lane\", \"Done\", null, null, null, null, 8, 13, 16, null, null, #datetime(2026,11,13,0,0,0), #datetime(2026,11,16,0,0,0), #datetime(2026,11,13,0,0,0), #datetime(2026,11,18,0,0,0), \"\", \"MIG-3214 · Build the semantic model\"},",
                "    {\"MIG-101\", \"MIG-55056\", \"MIG-3214\", \"Subtask\", \"Prepare build the semantic model evidence\", \"R. Lane\", \"Done\", null, null, null, null, null, null, null, null, null, null, null, null, null, \"\", \"↳ MIG-3214 / MIG-55056 · Prepare build the semantic model evidence\"},",
                "    {\"MIG-101\", \"MIG-55057\", \"MIG-3214\", \"Subtask\", \"Verify acceptance criteria\", \"R. Lane\", \"Done\", null, null, null, null, null, null, null, null, null, null, null, null, null, \"\", \"↳ MIG-3214 / MIG-55057 · Verify acceptance criteria\"},",
                "    {\"MIG-101\", \"MIG-3215\", \"MIG-101\", \"Task\", \"Reconcile source and target\", \"A. Chen\", \"In progress\", \"A stale FX rate could overstate client-reported market value.\", null, \"Join closing FX on currency and valuation date.\", \"N. Ellis\", 8, 16, 22, null, 20, #datetime(2026,11,16,0,0,0), #datetime(2026,11,22,0,0,0), #datetime(2026,11,17,0,0,0), null, \"Client statements may need reissue if sign-off uses the load-date FX rate.\", \"MIG-3215 · Reconcile source and target\"},",
                "    {\"MIG-101\", \"MIG-55059\", \"MIG-3215\", \"Subtask\", \"Prepare reconcile source and target evidence\", \"A. Chen\", \"In progress\", null, null, null, null, null, null, null, null, null, null, null, null, null, \"\", \"↳ MIG-3215 / MIG-55059 · Prepare reconcile source and target evidence\"},",
                "    {\"MIG-101\", \"MIG-55060\", \"MIG-3215\", \"Subtask\", \"Verify CAD closing rate\", \"A. Chen\", \"Blocked\", \"USD value differs for the CAD position.\", \"FX join uses load date instead of valuation date.\", \"Correct the join, rerun the comparison and request reviewer sign-off.\", \"N. Ellis\", null, null, null, 2, 20, null, null, null, null, \"Client statements may need reissue if sign-off uses the load-date FX rate.\", \"↳ MIG-3215 / MIG-55060 · Verify CAD closing rate\"},",
                "    {\"MIG-101\", \"MIG-3216\", \"MIG-101\", \"Story\", \"Run business acceptance\", \"S. Reed\", \"To do\", null, null, null, null, 5, 19, 25, null, null, #datetime(2026,11,19,0,0,0), #datetime(2026,11,25,0,0,0), null, null, \"\", \"MIG-3216 · Run business acceptance\"},",
                "    {\"MIG-101\", \"MIG-55062\", \"MIG-3216\", \"Subtask\", \"Prepare run business acceptance evidence\", \"S. Reed\", \"To do\", null, null, null, null, null, null, null, null, null, null, null, null, null, \"\", \"↳ MIG-3216 / MIG-55062 · Prepare run business acceptance evidence\"},",
