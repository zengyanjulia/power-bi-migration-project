        ],
        "measures": [
          {
            "name": "November schedule",
            "expression": "VAR base = DATE(2026,11,1)\nVAR s = SELECTEDVALUE(Items[Target Start Date])\nVAR e = SELECTEDVALUE(Items[Target End Date])\nVAR a = SELECTEDVALUE(Items[Actual Start Date])\nVAR b = COALESCE(SELECTEDVALUE(Items[Actual End Date]),[Schedule snapshot])\nVAR tone = SUBSTITUTE([Schedule color],\"#\",\"%23\")\nVAR goal = \"<rect x='\" & FORMAT(6*(s-base),\"0\") & \"' y='3' width='\" & FORMAT(6*(e-s+1),\"0\") & \"' height='5' rx='2' fill='%23ACC5D5'/>\"\nVAR elapsed = IF(NOT ISBLANK(a),\"<rect x='\" & FORMAT(6*(a-base),\"0\") & \"' y='11' width='\" & FORMAT(6*(b-a+1),\"0\") & \"' height='5' rx='2' fill='\" & tone & \"'/>\",\"\")\nRETURN IF(ISBLANK(s)||ISBLANK(e),BLANK(),\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='20' viewBox='0 0 180 20'><rect width='180' height='20' fill='%23FBF9F0'/>\" & goal & elapsed & \"<path d='M\" & FORMAT(6*([Schedule snapshot]-base+1),\"0\") & \" 0v20' stroke='%239C5339' stroke-dasharray='2 2'/></svg>\")",
            "dataCategory": "ImageUrl"
          },
          {
            "name": "Schedule snapshot",
            "expression": "DATE(2026,11,19)",
            "formatString": "mmm d, yyyy"
          },
          {
            "name": "Finish variance days",
            "expression": "VAR t=SELECTEDVALUE(Items[Target End Date]) VAR a=SELECTEDVALUE(Items[Actual End Date]) RETURN IF(HASONEVALUE(Items[Issue Key]) && NOT ISBLANK(t), INT(COALESCE(a,[Schedule snapshot])-t))",
            "formatString": "0"
          },
          {
            "name": "Schedule label",
            "expression": "VAR n=[Finish variance days] VAR a=SELECTEDVALUE(Items[Actual End Date])\nRETURN IF(ISBLANK(n),\"No dates\",IF(NOT ISBLANK(a),SWITCH(TRUE(),n>0,n & \"d late\",n<0,ABS(n) & \"d early\",\"On time\"),SWITCH(TRUE(),n>0,n & \"d overdue\",n=0,\"Due today\",ABS(n) & \"d left\")))"
          },
          {
            "name": "Schedule color",
            "expression": "VAR n=[Finish variance days] VAR a=SELECTEDVALUE(Items[Actual End Date]) RETURN SWITCH(TRUE(),ISBLANK(n),\"#61665C\",n>0,\"#A33230\",NOT ISBLANK(a),\"#1F6F56\",n>=-3,\"#8B5D00\",ISBLANK(SELECTEDVALUE(Items[Actual Start Date])),\"#61665C\",\"#1F6F56\")"
          },
          {
            "name": "Blocker color",
            "expression": "IF(LEN(SELECTEDVALUE(Items[Open Blocker]))>0,\"#A33230\",\"#373A36\")"
          }
        ]
      },
      {
        "name": "Phases",
        "columns": [
          {
            "name": "Stage",
            "dataType": "string",
            "sourceColumn": "Stage",
            "summarizeBy": "none",
            "sortByColumn": "Sequence"
          },
          {
            "name": "Sequence",
            "dataType": "int64",
            "sourceColumn": "Sequence",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Phases",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Source = #table(type table [#\"Stage\" = type text, #\"Sequence\" = Int64.Type], {",
                "    {\"Inventory\", 1},",
                "    {\"Discover\", 2},",
                "    {\"Model\", 3},",
                "    {\"Reconcile\", 4},",
                "    {\"UAT\", 5},",
                "    {\"Cutover\", 6}",
                "  })",
                "in",
                "  Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "In progress",
            "expression": "VAR n = SELECTEDVALUE(Phases[Sequence]) RETURN COALESCE(CALCULATE(DISTINCTCOUNT(Portfolio[Jira Key]),Portfolio[Phase Order]=n),0)",
            "formatString": "0"
          },
          {
            "name": "Completed stage",
            "expression": "VAR n = SELECTEDVALUE(Phases[Sequence]) RETURN COALESCE(CALCULATE(DISTINCTCOUNT(Portfolio[Jira Key]),Portfolio[Phase Order]>n),0)",
            "formatString": "0"
          }
        ]
      },
      {
        "name": "Valuation Test",
        "columns": [
          {
            "name": "Epic Key",
            "dataType": "string",
            "sourceColumn": "Epic Key",
            "summarizeBy": "none"
          },
          {
            "name": "Position",
            "dataType": "string",
            "sourceColumn": "Position",
            "summarizeBy": "none"
          },
          {
            "name": "Local Value",
            "dataType": "int64",
            "sourceColumn": "Local Value",
            "summarizeBy": "none"
          },
          {
            "name": "Closing FX cents",
            "dataType": "int64",
            "sourceColumn": "Closing FX cents",
            "summarizeBy": "none"
          },
          {
            "name": "Load FX cents",
            "dataType": "int64",
            "sourceColumn": "Load FX cents",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Valuation Test",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Source = #table(type table [#\"Epic Key\" = type text, #\"Position\" = type text, #\"Local Value\" = Int64.Type, #\"Closing FX cents\" = Int64.Type, #\"Load FX cents\" = Int64.Type], {",
                "    {\"MIG-101\", \"USD book A\", 10000000, 100, 100},",
                "    {\"MIG-101\", \"USD book B\", 1810000, 100, 100},",
                "    {\"MIG-101\", \"CAD position\", 920000, 75, 77}",
                "  })",
                "in",
                "  Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Legacy USD",
            "expression": "SUMX('Valuation Test','Valuation Test'[Local Value]*'Valuation Test'[Closing FX cents]/100)",
            "formatString": "$#,##0"
          },
          {
            "name": "Original target USD",
            "expression": "SUMX('Valuation Test','Valuation Test'[Local Value]*'Valuation Test'[Load FX cents]/100)",
            "formatString": "$#,##0"
          },
          {
            "name": "FX variance USD",
            "expression": "[Original target USD]-[Legacy USD]",
            "formatString": "$#,##0"
          },
          {
            "name": "Retest USD",
            "expression": "SUMX('Valuation Test','Valuation Test'[Local Value]*'Valuation Test'[Closing FX cents]/100)",
            "formatString": "$#,##0"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "10af4151-99ac-5f17-a501-45d15f8a2c9e",
        "fromTable": "Items",
        "fromColumn": "Epic Key",
        "toTable": "Portfolio",
        "toColumn": "Jira Key"
      },
      {
        "name": "a0791bbd-e3fa-5453-bb55-9fc10aa70dcb",
