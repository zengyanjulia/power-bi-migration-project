        "partitions": [
          {
            "name": "Portfolio",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Source = #table(type table [#\"Jira Key\" = type text, #\"Report or Epic\" = type text, #\"Assignee\" = type text, #\"Phase\" = type text, #\"Health\" = type text, #\"Next Milestone\" = type text, #\"Baseline\" = type text, #\"Forecast\" = type text, #\"Audience\" = type text, #\"Business Owner\" = type text, #\"Source Platform\" = type text, #\"Acceptance Test\" = type text, #\"Wave\" = type text, #\"Phase Order\" = Int64.Type, #\"Drift Days\" = Int64.Type, #\"Target format\" = type text, #\"SQL Server dataset command\" = type text, #\"Upstream SSIS package\" = type text, #\"SSIS transformation\" = type text, #\"Delivery rationale\" = type text, #\"Format acceptance\" = type text], {",
                "    {\"MIG-101\", \"Portfolio Appraisal\", \"N. Ellis\", \"Reconcile\", \"At risk\", \"Valuation sign-off\", \"2026-11-20\", \"2026-11-24\", \"Client Reporting\", \"Institutional client service\", \"SSRS\", \"Tie USD value by mandate, security and valuation date. Check the FX rate date.\", \"Wave 1\", 4, 4, \"Both\", \"usp_PortfolioAppraisal(@MandateId, @AsOfDate)\", \"LoadClosingFX.dtsx\", \"Loads the approved valuation-date FX rate into the reporting mart.\", \"Publish a client PDF and give Operations a security-level view of valuation differences.\", \"Tie both outputs by mandate, security and date. Check client pagination and header totals.\"},",
                "    {\"MIG-102\", \"Realized Gains and Losses Statement\", \"M. Park\", \"UAT\", \"On track\", \"Client scope approval\", \"2026-11-24\", \"2026-11-24\", \"Client Reporting\", \"Investment accounting\", \"SSRS\", \"Match disposal and tax-lot keys, cost basis and proceeds for the same sales.\", \"Wave 1\", 5, 0, \"Paginated\", \"usp_RealizedGains(@AccountId, @FromDate, @ToDate)\", \"LoadTaxLots.dtsx\", \"Loads lot-relief records used to calculate realized gains and losses.\", \"Keep the fixed-format statement with one section per account and tax lot.\", \"Match each disposal, proceeds and cost basis. Verify account filters, repeated headers and PDF page totals.\"},",
                "    {\"MIG-103\", \"Quarterly Portfolio Review\", \"R. Lane\", \"Cutover\", \"On track\", \"Production cutover\", \"2026-11-25\", \"2026-11-25\", \"Client Reporting\", \"Institutional client service\", \"SSRS\", \"Align reporting period, benchmark version and gross or net return convention.\", \"Wave 1\", 6, 0, \"Both\", \"usp_QuarterlyReview(@MandateId, @QuarterEnd)\", \"LoadBenchmarks.dtsx\", \"Aligns portfolio and benchmark periods before the quarterly close.\", \"Use an interactive investment review and a paginated quarterly client pack.\", \"Compare gross and net returns for the same period and benchmark across both outputs.\"},",
                "    {\"MIG-104\", \"Performance Attribution\", \"A. Chen\", \"Model\", \"On track\", \"Model review\", \"2026-11-26\", \"2026-11-26\", \"Client Reporting\", \"Portfolio managers\", \"SSRS\", \"Reconcile the sum of effects and any disclosed residual to the active return.\", \"Wave 2\", 3, 0, \"Interactive\", \"T-SQL query of rpt.vw_AttributionDaily\", \"LoadAttributionInputs.dtsx\", \"Loads portfolio and benchmark weights at security and date grain.\", \"Let analysts compare allocation and selection effects by sector.\", \"Reconcile contribution totals and sector subtotals for a fixed period.\"},",
                "    {\"MIG-105\", \"AUM Rollforward & Net Flows\", \"S. Reed\", \"Discover\", \"At risk\", \"Benchmark mapping\", \"2026-11-23\", \"2026-11-25\", \"Internal Management\", \"FP&A and executive management\", \"SSRS\", \"Bridge opening to closing AUM using net flows, market, FX and any other adjustments.\", \"Wave 2\", 2, 2, \"Interactive\", \"T-SQL query of rpt.vw_AUMBridge\", \"ClassifyMandateFlows.dtsx\", \"Classifies client flows separately from market and currency movements.\", \"Explain changes in assets under management by mandate and driver.\", \"Tie opening AUM plus flows, market, FX and other changes to closing AUM.\"},",
                "    {\"MIG-106\", \"Management Fee Revenue & Billing Reconciliation\", \"P. Noor\", \"Reconcile\", \"Blocked\", \"Source extract approval\", \"2026-11-23\", \"2026-11-27\", \"Internal Finance\", \"Revenue accounting\", \"SSRS\", \"Apply fee tiers and effective dates, then reconcile accruals to the ledger and invoices.\", \"Wave 2\", 4, 4, \"Paginated\", \"usp_FeeBillingReconciliation(@BillingPeriod)\", \"LoadFeesAndInvoices.dtsx\", \"Stages effective-dated fee schedules and posted invoices.\", \"Produce a controlled month-end reconciliation with invoice-level detail.\", \"Tie invoice totals to the fee ledger and compare billing-period PDF subtotals.\"},",
                "    {\"MIG-107\", \"Daily Cash & Position Reconciliation\", \"G. Silva\", \"Inventory\", \"On track\", \"Scope sign-off\", \"2026-11-27\", \"2026-11-27\", \"Internal Operations\", \"Investment operations\", \"SSRS\", \"Tie cash by account and currency, and quantities by account and security. Test unmatched rows.\", \"Wave 3\", 1, 0, \"Interactive\", \"T-SQL query of rpt.vw_CustodyBreaks\", \"LoadCustodianPositions.dtsx\", \"Normalizes custodian account and security identifiers before matching positions.\", \"Let Operations filter breaks by account, currency, security and age.\", \"Match open-break counts and amounts by account and currency.\"},",
                "    {\"MIG-108\", \"Daily Failed Trades Report\", \"A. Chen\", \"UAT\", \"On track\", \"Security retest\", \"2026-11-24\", \"2026-11-24\", \"Internal Operations\", \"Trade support\", \"SSRS\", \"Match trade IDs and expected settlement dates. Verify open-only filters and business-day aging.\", \"Wave 1\", 5, 0, \"Paginated\", \"usp_FailedTrades(@SettlementDate)\", \"LoadSettlementStatus.dtsx\", \"Brings in the latest custody confirmation for each settlement obligation.\", \"Deliver a dated exception list to the settlements desk.\", \"Tie trade IDs and failed amounts to the same cut-off and test the empty-report case.\"},",
                "    {\"MIG-109\", \"Operating Expenses — Budget vs. Actual\", \"A. Chen\", \"Discover\", \"On track\", \"Owner review\", \"2026-11-26\", \"2026-11-26\", \"Internal Finance\", \"Corporate FP&A\", \"SSRS\", \"Match fiscal period, cost center and approved budget version to the general ledger.\", \"Wave 3\", 2, 0, \"Interactive\", \"T-SQL query of rpt.vw_ExpenseVariance\", \"LoadGLAndBudget.dtsx\", \"Loads the approved budget version and ledger postings by cost centre.\", \"Explore expense variances by account, cost centre and period.\", \"Compare actuals and budget versions by cost centre and month.\"},",
                "    {\"MIG-110\", \"Investment Guideline Breach Monitor\", \"G. Silva\", \"UAT\", \"On track\", \"Owner review\", \"2026-11-26\", \"2026-11-26\", \"Internal Risk\", \"Investment compliance\", \"SSRS\", \"Test a position at the limit and above it. Verify effective dates, waivers and access by mandate.\", \"Wave 3\", 5, 0, \"Interactive\", \"usp_MandateBreaches(@AsOfDate)\", \"EvaluateGuidelineLimits.dtsx\", \"Applies mandate-specific thresholds and effective waiver dates.\", \"Let Compliance inspect active exceptions by mandate and rule.\", \"Reconcile active and waived breaches at the same as-of date.\"}",
                "  })",
                "in",
                "  Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Active epics",
            "expression": "DISTINCTCOUNT(Portfolio[Jira Key])",
            "formatString": "0"
          },
          {
            "name": "At risk",
            "expression": "CALCULATE([Active epics],Portfolio[Health]=\"At risk\")",
            "formatString": "0"
          },
          {
            "name": "Blocked",
            "expression": "CALCULATE([Active epics],Portfolio[Health]=\"Blocked\")",
            "formatString": "0"
          },
          {
            "name": "Done SP",
            "expression": "COALESCE(CALCULATE(SUM(Items[Story Points]),Items[Status]=\"Done\",Items[Item Type]<>\"Subtask\"),0)",
            "formatString": "0"
          },
          {
            "name": "Total SP",
            "expression": "SUMX(FILTER(Items,Items[Item Type]<>\"Subtask\"),Items[Story Points])",
            "formatString": "0"
          },
          {
            "name": "Completion",
            "expression": "DIVIDE([Done SP],[Total SP])",
            "formatString": "0%"
          },
          {
            "name": "Unestimated",
            "expression": "COALESCE(COUNTROWS(FILTER(Items,Items[Item Type]<>\"Subtask\" && ISBLANK(Items[Story Points]))),0)",
            "formatString": "0"
          }
        ]
      },
